{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestLineSize": 32768,
      "MaxRequestHeaderCount": 200,
      "MaxRequestBodySize": 52428800
    },
    "Endpoints": {
      "MyHttpsEndpoint": {
        "Url": "https://192.168.41.225:14002",
        "SslProtocols": ["Tls12", "Tls13"],
        "ClientCertificateMode": "AllowCertificate",
        "Certificate": {
          "Path": "./20260410155659.pfx", //  ./mycertificate.pfx
          "Password": "123456"
        }
      }
    }
  },
  "Keycloak": {
    "CookieName": "beam_cookie",
    "Authority": "https://192.168.41.225:8443/realms/beam",
    "Audience": "webapi1",
    "ValidateAudience": true,
    "ValidAudiences": [ "webapi1", "account" ],
    "RequireHttpsMetadata": true,
    "AllowInsecureBackchannel": true,
    "ValidIssuer": "https://192.168.41.225:8443/realms/beam"
  }
}
